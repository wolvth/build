#!/bin/sh
# natmap `logger` shim -- installed in /usr/lib/natmap/bin/ and visible ONLY
# inside the callback process tree (update-local.sh prepends that PATH).
# Keeps `logger -t "NATMAP-CF" ...` messages out of the system log.
LOG_FILE="${NATMAP_LOG_FILE:-/var/log/natmap.log}"
tag=""
while [ "$#" -gt 0 ]; do
        case "$1" in
                -t) tag="${2:-}"; shift 2 ;;
                -p) shift 2 ;;
                -s) shift ;;
                -*) shift ;;
                *) break ;;
        esac
done
printf '[%s] %s%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" \
        "${tag:+[$tag] }" "$*" >> "$LOG_FILE"
