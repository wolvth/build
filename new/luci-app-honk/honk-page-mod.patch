+	let rp = match(content, /\)\s+(.*)$/);
+	if (!rp) return null;
+	let f = split(trim(rp[1]), /\s+/);
+	// after comm: state(3) is f[0], so utime(14)=f[11], stime(15)=f[12],
+	// num_threads(20)=f[17], starttime(22)=f[19]
+	return {
+		utime: (+f[11]) || 0,
+		stime: (+f[12]) || 0,
+		threads: (+f[17]) || 0,
+		starttime: (+f[19]) || 0
+	};
+}
