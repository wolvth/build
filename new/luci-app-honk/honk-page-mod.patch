+function get_system_uptime() {
+	let m = match(readfile("/proc/uptime") || "", /^([0-9.]+)/);
+	return m ? +m[1] : 0;
+}
+
+function format_uptime(sec) {
+	sec = int(sec);
+	if (sec < 0) sec = 0;
+	if (sec < 3600) return sprintf("%dm %ds", int(sec / 60), sec % 60);
+	if (sec < 86400) return sprintf("%dh %dm", int(sec / 3600), int((sec % 3600) / 60));
+	return sprintf("%dd %dh", int(sec / 86400), int((sec % 86400) / 3600));
