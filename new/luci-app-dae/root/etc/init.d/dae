#!/bin/sh /etc/rc.common
# Copyright (C) 2023 Tianling Shen <cnsztl@immortalwrt.org>

USE_PROCD=1
START=99
STOP=01

extra_command "hot_reload" "Hot-reload service"

NAME="dae"
PROG="/usr/bin/dae"
CONF="/etc/dae/config.dae"
LOG="/var/log/dae/dae.log"

ensure_uci_config() {
    [ ! -f /etc/config/dae ] && touch /etc/config/dae
	if ! uci -q get dae.config >/dev/null 2>&1; then
		uci set dae.config=dae
		uci set dae.config.enabled='1'
		uci set dae.config.log_maxbackups='1'
		uci set dae.config.log_maxsize='1'
		uci commit dae
	fi
}

# 失败原因要同时进 syslog 和 dae.log —— LuCI 的"启动失败"弹窗读的是 dae.log
init_log() {
	logger -t dae "$1"
	printf '[%s] [init] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG"
}

start_service() {
    ensure_uci_config
    config_load $NAME
    mkdir -p /var/log/dae

	local enabled
	config_get_bool enabled "config" "enabled" "0"
	if [ "$enabled" -ne 1 ]; then
		init_log "dae is disabled by uci (dae.config.enabled=0), start skipped; enable it with: uci set dae.config.enabled=1 && uci commit dae"
		return 1
	fi

	if [ "$(uci -q get honk.config.enabled)" = 1 ] &&
		ubus call service list '{"name":"honk"}' 2>/dev/null |
		jsonfilter -q -e '@.honk.instances[*].running' | grep -q true; then
                init_log "honk is running; dae and honk cannot run at the same time, disable honk first"
		return 1
	fi

	# 配置缺失/不可读时说清原因，别等 dae validate 报 "section global is required"
	if [ ! -r "$CONF" ]; then
		init_log "configuration file '$CONF' is missing or unreadable"
		return 1
	fi

	# 没有 BTF 时 dae 加载 eBPF 会报一堆难懂的错误，先挡一道（同官方 dae.init）
	if [ ! -e /sys/kernel/btf/vmlinux ] && [ ! -e "/usr/lib/debug/boot/vmlinux-$(uname -r)" ]; then
		init_log "the kernel has no BTF: run 'apk update && apk upgrade vmlinux-btf-builtin'"
		return 1
	fi

    $PROG validate -c $CONF >> $LOG 2>&1 || return 1

	local log_maxbackups log_maxsize
	config_get log_maxbackups "config" "log_maxbackups" "1"
	config_get log_maxsize "config" "log_maxsize" "1"

	procd_open_instance "$NAME"
        procd_set_param command "$PROG" run
        procd_append_param command --config "$CONF"
		procd_append_param command --logfile "$LOG"
		procd_append_param command --logfile-maxbackups "$log_maxbackups"
		procd_append_param command --logfile-maxsize "$log_maxsize"

		procd_set_param limits core="unlimited"
		procd_set_param limits nofile="1000000 1000000"
		procd_set_param respawn
		procd_set_param stderr 1

	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
}

# 不定义 reload_service 时，rc.common 的 reload 退化成 start：跑一遍 validate 但
# dae 不重读配置（只认 SIGUSR1），且配置非法时 start_service 不加实例 = procd 停服务。
# 做法同官方 dae.init，只多一道 validate —— 配置写坏了就别发信号，让旧实例继续跑。
reload_service() {
	config_load "$NAME"

	local enabled
	config_get_bool enabled "config" "enabled" 0
	if [ "$enabled" -ne 1 ] || ! procd_running "$NAME" "$NAME"; then
		start
		return
	fi

	if ! "$PROG" validate -c "$CONF" >> "$LOG" 2>&1; then
		init_log "reload skipped: configuration '$CONF' failed validation"
		return 1
	fi

	# dae 收 SIGUSR1 重读配置并保持已建连接（`dae reload` 发的就是它）
	procd_send_signal "$NAME" "$NAME" USR1
}

hot_reload() {
	# dae reload 不带参数时会自己读 /var/run/dae.pid，读不到或信号失败都返回非 0
	"$PROG" reload
}
